# Copy to .env (local) or add these in Vercel > Project > Settings > Environment Variables

# Your live website address, no trailing slash. Used for WhatsApp/Facebook link previews.
VITE_SITE_URL=https://your-real-domain.com

# Form endpoint (e.g. a free Formspree form: https://formspree.io/f/xxxxxxx).
# Contact, Apply and Franchise forms are sent here. If empty, the forms open the visitor's email app instead.
VITE_FORM_ENDPOINT=
