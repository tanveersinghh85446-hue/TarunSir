# Copy these into Vercel: Project > Settings > Environment Variables.
# For local testing with "vercel dev", put them in a file named .env.local
# NEVER commit the real values to git.

# The Gmail address that SENDS the mail
MAIL_USER=anitioinstitute@gmail.com

# 16 letter Gmail App Password (NOT your normal Gmail password)
MAIL_PASS=xxxxxxxxxxxxxxxx

# Where you want to RECEIVE the mails (optional, defaults to MAIL_USER)
MAIL_TO=anitioinstitute@gmail.com
